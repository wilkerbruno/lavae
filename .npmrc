# Torna `pnpm install` mais resistente a instabilidade de rede (ex.: no
# servidor de build do EasyPanel, onde já vimos ECONNRESET/EAI_AGAIN ao
# baixar pacotes do registro do npm). Menos conexões em paralelo + mais
# tentativas com espera maior entre elas.
network-concurrency=4
fetch-retries=6
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
