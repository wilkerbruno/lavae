{
  "expo": {
    "name": "lavaê",
    "slug": "lavajato-one",
    "scheme": "lavajatoapp",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.divisionstech.lavajatoone",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#29323d"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "_comment": "Rode `eas init` neste projeto para gerar o projectId do Expo (necessário para notificações push e atualizações OTA). Não reutilize o projectId do BarberOne.",
        "projectId": "be0d7822-0536-4756-9c14-1db5252eb77d"
      }
    },
    "owner": "wilkerbruno"
  }
}
